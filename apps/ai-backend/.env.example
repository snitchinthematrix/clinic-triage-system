GEMINI_API_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=
# Legacy HS256 projects only. Newer Supabase projects sign tokens with an
# asymmetric key instead — SUPABASE_URL is required for those (used to
# fetch /auth/v1/.well-known/jwks.json). Setting both is safe; requireAuth
# picks the right one per-token based on its alg header.
SUPABASE_JWT_SECRET=
SUPABASE_URL=
ALLOWED_ORIGIN=http://localhost:5173
PORT=4000
